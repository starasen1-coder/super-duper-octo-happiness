{
  "name": "xauusd-m5-research",
  "version": "0.1.0",
  "private": true,
  "description": "Reproducible offline XAUUSD historical data research tools",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
